{
  "name": "@forshtat/hegota-support",
  "version": "0.0.1",
  "description": "Helpers for the Hegota frame-transaction EIPs (8141, 8250, 7906, ...): HegotaSupport.sol, which gives Solidity the frame opcodes, and a profile-driven TypeScript codec for the transactions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forshtat/hegota-support.git"
  },
  "engines": {
    "node": ">=20.12"
  },
  "files": [
    "dist",
    "contracts",
    "yul",
    "README.md"
  ],
  "exports": {
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "default": "./dist/profiles/index.js"
    },
    "./profiles/*": {
      "types": "./dist/profiles/*.d.ts",
      "default": "./dist/profiles/*.js"
    },
    "./tx": {
      "types": "./dist/tx/index.d.ts",
      "default": "./dist/tx/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "default": "./dist/rpc/index.js"
    },
    "./solidity": {
      "types": "./dist/solidity/index.d.ts",
      "default": "./dist/solidity/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:tools": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "yarn build:tools && node --test build/test/*.test.js",
    "new-profile": "yarn --silent build:tools && node build/scripts/new-profile.js",
    "remove-profile": "yarn --silent build:tools && node build/scripts/remove-profile.js",
    "pin-vectors": "yarn --silent build:tools && node build/scripts/pin-vectors.js",
    "smoke": "node scripts/smoke.mjs",
    "verify": "yarn typecheck && yarn test && yarn build && yarn smoke && yarn check:helpers && yarn test:sol",
    "build:helpers": "node scripts/build-helpers.mjs",
    "check:helpers": "yarn build:helpers && git diff --exit-code -- contracts/generated",
    "test:sol": "forge test",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "viem": "^2.57.0",
    "solc": "0.8.28"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "solc": "0.8.28",
    "typescript": "^5.9.3",
    "viem": "^2.57.10"
  },
  "peerDependenciesMeta": {
    "solc": {
      "optional": true
    }
  },
  "homepage": "https://github.com/forshtat/hegota-support#readme",
  "bugs": {
    "url": "https://github.com/forshtat/hegota-support/issues"
  },
  "keywords": [
    "eip-8141",
    "frame-transactions",
    "hegota",
    "ethereum",
    "solidity"
  ],
  "publishConfig": {
    "access": "public"
  }
}
